# HomeLedger Pro — Backend Environment Variables
# Copy this file to server/.env and fill in your real values.
# NEVER commit server/.env to Git. It is already listed in .gitignore.

# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Get this from: https://console.neon.tech → Your Project → Connection string
DATABASE_URL=postgresql://your_username:your_password@your_host/homeledger?sslmode=require

# Set to "true" when connecting to Neon (required for SSL)
DATABASE_SSL=true

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_strong_random_secret_at_least_32_characters_long

# ── Server Port ───────────────────────────────────────────────────────────────
PORT=5000
